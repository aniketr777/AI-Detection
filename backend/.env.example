# Backend Server Environment Variables
PORT=5000
NODE_ENV=development

# ─── IMPORTANT: Set this to your deployed frontend URL ───────────────────────
# Used for CORS and honeypot Origin-header validation.
# Real browser API calls carry Origin: <CLIENT_URL> → real data served.
# Crawlers / AI chat browsers / curl with wrong/no Origin → decoy Redmi data.
CLIENT_URL=https://your-frontend.vercel.app

# ─── Optional extra IP layer (rarely needed if CLIENT_URL is set) ─────────────
# Only set if you want to restrict access to a single IP on top of Origin checks.
ALLOWED_VISITOR_IP=
